{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kenmege/codex-claude-companion/schemas/bridge-event.schema.json",
  "title": "Codex-Claude Bridge ordered event",
  "description": "One entry in a durable at-least-once event stream, versioned by schemaVersion. Consumers deduplicate by deduplicationKey. In schemaVersion 2 either family may be the job's origin or its worker. Validators require a family author to take part in the job and keep its 1.x role: progress, question, blocked, completed, failed and cancelled come from the worker family, and cancel_requested from the origin family.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": { "schemaVersion": { "enum": [1, 2] } },
  "oneOf": [{ "$ref": "#/$defs/v1" }, { "$ref": "#/$defs/v2" }],
  "$defs": {
  "v1": {
  "title": "Codex-Claude Bridge ordered event",
  "description": "One entry in a durable at-least-once event stream. Consumers deduplicate by deduplicationKey.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "sequence", "timestamp", "type", "sender", "deduplicationKey", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "pattern": "^ccb_[0-9A-HJKMNP-TV-Z]{26}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "enum": ["accepted", "started", "progress", "question", "codex_message", "claude_message", "blocked", "completed", "failed", "cancel_requested", "cancelled", "verified"] },
    "sender": { "enum": ["bridge", "codex", "claude", "verifier"] },
    "deduplicationKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/accepted" },
    { "$ref": "#/$defs/started" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/question" },
    { "$ref": "#/$defs/codexMessage" },
    { "$ref": "#/$defs/claudeMessage" },
    { "$ref": "#/$defs/blocked" },
    { "$ref": "#/$defs/completed" },
    { "$ref": "#/$defs/failed" },
    { "$ref": "#/$defs/cancelRequested" },
    { "$ref": "#/$defs/cancelled" },
    { "$ref": "#/$defs/verified" }
  ]
  },
    "messagePayload": {
      "type": "object", "additionalProperties": false, "required": ["messageId", "text"],
      "properties": {
        "messageId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "replyTo": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "codexMessagePayload": {
      "type": "object", "additionalProperties": false, "required": ["messageId", "text"],
      "properties": {
        "messageId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "replyTo": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "accepted": {
      "type": "object",
      "properties": {
        "type": { "const": "accepted" }, "sender": { "const": "bridge" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["acceptedAt"], "properties": { "acceptedAt": { "type": "string", "format": "date-time" } } }
      }
    },
    "started": {
      "type": "object",
      "properties": {
        "type": { "const": "started" }, "sender": { "const": "bridge" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["executor"], "properties": { "executor": { "enum": ["tmux", "native-background"] } } }
      }
    },
    "progress": {
      "type": "object",
      "properties": {
        "type": { "const": "progress" }, "sender": { "enum": ["bridge", "claude"] },
        "payload": { "type": "object", "additionalProperties": false, "required": ["message"], "properties": { "message": { "type": "string", "minLength": 1 }, "percent": { "type": "integer", "minimum": 0, "maximum": 100 } } }
      }
    },
    "question": {
      "type": "object",
      "properties": {
        "type": { "const": "question" }, "sender": { "const": "claude" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["questionId", "text"], "properties": { "questionId": { "type": "string", "minLength": 1, "maxLength": 256 }, "text": { "type": "string", "minLength": 1, "maxLength": 4000 } } }
      }
    },
    "codexMessage": { "type": "object", "properties": { "type": { "const": "codex_message" }, "sender": { "const": "codex" }, "payload": { "$ref": "#/$defs/codexMessagePayload" } } },
    "claudeMessage": { "type": "object", "properties": { "type": { "const": "claude_message" }, "sender": { "const": "claude" }, "payload": { "$ref": "#/$defs/messagePayload" } } },
    "blocked": {
      "type": "object",
      "properties": {
        "type": { "const": "blocked" }, "sender": { "enum": ["bridge", "claude"] },
        "payload": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
      }
    },
    "completed": {
      "type": "object",
      "properties": {
        "type": { "const": "completed" }, "sender": { "enum": ["bridge", "claude"] },
        "payload": { "type": "object", "additionalProperties": false, "required": ["resultPath"], "properties": { "resultPath": { "type": "string", "pattern": "^/" } } }
      }
    },
    "failed": {
      "type": "object",
      "properties": {
        "type": { "const": "failed" }, "sender": { "enum": ["bridge", "claude"] },
        "payload": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } }
      }
    },
    "cancelRequested": {
      "type": "object",
      "properties": {
        "type": { "const": "cancel_requested" }, "sender": { "enum": ["bridge", "codex"] },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["reason", "requestedAt"],
          "properties": { "reason": { "type": "string", "minLength": 1 }, "requestedAt": { "type": "string", "format": "date-time" } }
        }
      }
    },
    "cancelled": {
      "type": "object",
      "properties": {
        "type": { "const": "cancelled" }, "sender": { "enum": ["bridge", "claude"] },
        "payload": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
      }
    },
    "verified": {
      "type": "object",
      "properties": {
        "type": { "const": "verified" }, "sender": { "const": "verifier" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["verdict", "evidence"],
          "properties": { "verdict": { "enum": ["passed", "failed"] }, "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    "v2": {
      "$comment": "Payloads are the 1.x payload schemas, referenced in place. Origin-authored messages of either family may carry contentSha256.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "jobId", "sequence", "timestamp", "type", "sender", "deduplicationKey", "payload"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "jobId": { "$ref": "#/$defs/v1/properties/jobId" },
        "sequence": { "$ref": "#/$defs/v1/properties/sequence" },
        "timestamp": { "$ref": "#/$defs/v1/properties/timestamp" },
        "type": { "$ref": "#/$defs/v1/properties/type" },
        "sender": { "$ref": "#/$defs/v1/properties/sender" },
        "deduplicationKey": { "$ref": "#/$defs/v1/properties/deduplicationKey" },
        "payload": { "type": "object" }
      },
      "oneOf": [
        { "properties": { "type": { "const": "accepted" }, "sender": { "const": "bridge" }, "payload": { "$ref": "#/$defs/accepted/properties/payload" } } },
        { "properties": { "type": { "const": "started" }, "sender": { "const": "bridge" }, "payload": { "$ref": "#/$defs/started/properties/payload" } } },
        { "properties": { "type": { "const": "progress" }, "sender": { "enum": ["bridge", "claude", "codex"] }, "payload": { "$ref": "#/$defs/progress/properties/payload" } } },
        { "properties": { "type": { "const": "question" }, "sender": { "enum": ["claude", "codex"] }, "payload": { "$ref": "#/$defs/question/properties/payload" } } },
        { "properties": { "type": { "const": "codex_message" }, "sender": { "const": "codex" }, "payload": { "$ref": "#/$defs/codexMessagePayload" } } },
        { "properties": { "type": { "const": "claude_message" }, "sender": { "const": "claude" }, "payload": { "$ref": "#/$defs/codexMessagePayload" } } },
        { "properties": { "type": { "const": "blocked" }, "sender": { "enum": ["bridge", "claude", "codex"] }, "payload": { "$ref": "#/$defs/blocked/properties/payload" } } },
        { "properties": { "type": { "const": "completed" }, "sender": { "enum": ["bridge", "claude", "codex"] }, "payload": { "$ref": "#/$defs/completed/properties/payload" } } },
        { "properties": { "type": { "const": "failed" }, "sender": { "enum": ["bridge", "claude", "codex"] }, "payload": { "$ref": "#/$defs/failed/properties/payload" } } },
        { "properties": { "type": { "const": "cancel_requested" }, "sender": { "enum": ["bridge", "codex", "claude"] }, "payload": { "$ref": "#/$defs/cancelRequested/properties/payload" } } },
        { "properties": { "type": { "const": "cancelled" }, "sender": { "enum": ["bridge", "claude", "codex"] }, "payload": { "$ref": "#/$defs/cancelled/properties/payload" } } },
        { "properties": { "type": { "const": "verified" }, "sender": { "const": "verifier" }, "payload": { "$ref": "#/$defs/verified/properties/payload" } } }
      ]
    }
  }
}
