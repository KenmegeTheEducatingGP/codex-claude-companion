{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kenmege/codex-claude-companion/schemas/bridge-result.schema.json",
  "title": "Codex-Claude Bridge result",
  "description": "Structured worker outcome, versioned by schemaVersion. Completion here does not imply delivery, acknowledgement, or verification. schemaVersion 2 names the worker family and replaces claudeSessionId with workerSessionId.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": { "schemaVersion": { "enum": [1, 2] } },
  "oneOf": [{ "$ref": "#/$defs/v1" }, { "$ref": "#/$defs/v2" }],
  "$defs": {
  "v1": {
  "title": "Codex-Claude Bridge result",
  "description": "Structured worker outcome. Completion here does not imply delivery, acknowledgement, or verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "status",
    "summary",
    "filesChanged",
    "commandsRun",
    "testsRun",
    "findings",
    "blockers",
    "claudeSessionId",
    "exitStatus",
    "artifactPaths"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "pattern": "^ccb_[0-9A-HJKMNP-TV-Z]{26}$" },
    "status": { "enum": ["completed", "failed", "cancelled"] },
    "summary": { "type": "string" },
    "filesChanged": {
      "description": "Workspace-relative paths whose contents, type, or existence this worker actually changed during this job. Excludes files only reviewed or inspected and files already dirty but unchanged by the worker; read-only and no-edit jobs report an empty array.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "commandsRun": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandEvidence" }
    },
    "testsRun": {
      "type": "array",
      "items": { "$ref": "#/$defs/testEvidence" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportItem" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportItem" }
    },
    "claudeSessionId": { "type": ["string", "null"], "minLength": 1 },
    "exitStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "signal"],
      "properties": {
        "code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] }
      }
    },
    "artifactPaths": {
      "type": "array",
      "items": { "type": "string", "pattern": "^/" }
    }
  }
  },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "exitCode"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "interrupted", "unknown"] },
        "exitCode": { "type": ["integer", "null"] }
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "summary"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not-run"] },
        "summary": { "type": "string" }
      }
    },
    "reportItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "workerFamily",
        "status",
        "summary",
        "filesChanged",
        "commandsRun",
        "testsRun",
        "findings",
        "blockers",
        "workerSessionId",
        "plan",
        "exitStatus",
        "artifactPaths"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "jobId": { "$ref": "#/$defs/v1/properties/jobId" },
        "workerFamily": { "enum": ["claude", "codex"] },
        "status": { "$ref": "#/$defs/v1/properties/status" },
        "summary": { "$ref": "#/$defs/v1/properties/summary" },
        "filesChanged": { "$ref": "#/$defs/v1/properties/filesChanged" },
        "commandsRun": { "$ref": "#/$defs/v1/properties/commandsRun" },
        "testsRun": { "$ref": "#/$defs/v1/properties/testsRun" },
        "findings": { "$ref": "#/$defs/v1/properties/findings" },
        "blockers": { "$ref": "#/$defs/v1/properties/blockers" },
        "workerSessionId": { "type": ["string", "null"], "minLength": 1, "description": "The worker's native session: the Claude session id or the Codex thread id." },
        "plan": { "type": ["string", "null"], "minLength": 1, "description": "The worker's stated plan; a repair attempt must state one before any edit." },
        "exitStatus": { "$ref": "#/$defs/v1/properties/exitStatus" },
        "artifactPaths": { "$ref": "#/$defs/v1/properties/artifactPaths" }
      }
    }
  }
}
